<?xml version="1.0" encoding="utf-8"?>
<!-- 당근 화면 읽기 (개발 5단계): 당근 앱 화면만 받고, 화면 글자를 읽기만 함. 누르기·입력(제스처)은 쓰지 않음.
     flagReportViewIds: 웹뷰의 탭 이름(tabs:opened…)으로 지원자 목록에서 고른 탭을 알기 위해 -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagIncludeNotImportantViews|flagReportViewIds"
    android:canPerformGestures="false"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_description"
    android:notificationTimeout="300"
    android:packageNames="com.towneers.www" />
