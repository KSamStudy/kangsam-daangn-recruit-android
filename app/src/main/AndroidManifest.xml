<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 당근 가져오기(프로세스 C)가 당근 앱을 열기 위해: Android 11부터 다른 앱을 찾으려면 여기에 적어야 함 -->
    <queries>
        <package android:name="com.towneers.www" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KangsamDaangnRecruit">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.KangsamDaangnRecruit"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 당근 알림 기록 서비스 (폰 설정에서 알림 접근 권한을 켜야 동작) -->
        <service
            android:name=".DaangnNotificationListener"
            android:exported="false"
            android:label="당근 구인 알림 기록"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 당근 화면 읽기 (폰 설정 → 접근성에서 켜야 동작, 개발 5단계) = 당근 가져오기(프로세스 C, sync 폴더)의 손.
             당근 화면만 읽고, '당근에서 가져오기' 버튼을 눌렀을 때만 화면을 옮기는 칸을 누름. 입력·전송은 하지 않음 -->
        <service
            android:name=".DaangnAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/daangn_accessibility" />
        </service>
    </application>

</manifest>